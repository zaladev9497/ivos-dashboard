# Copy to .env.local (local) or set in your host's environment variables (production).
# Never commit real values.

# Supabase project (server-side only — the service role key bypasses RLS, keep it secret)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in
# Long random string used to sign session cookies (e.g. `openssl rand -base64 48`). REQUIRED in production.
AUTH_SECRET=
# Shared dashboard password
DASHBOARD_PASSWORD=
# Optional: comma-separated emails allowed to sign in. Leave empty to allow any email with the password.
DASHBOARD_ALLOWED_EMAILS=

# n8n webhook that runs the cadence poller once (used by the demo "Advance" button)
N8N_POLLER_RUN_URL=
